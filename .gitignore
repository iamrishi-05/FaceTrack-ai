# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as long as your logic isn't
#  inside the exe, you can ignore these.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosexy
.nosetests
.pytest_cache/
venv/
.venv/
ENV/
env/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak
venv.bak

# SQLite databases
*.db
*.sqlite3

